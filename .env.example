# Set the tested image tag (image) or digest from the delivery bundle's release.json.
POWER_FORECAST_IMAGE=

# Keep loopback unless a firewall or gateway restricts remote access.
POWER_FORECAST_BIND=127.0.0.1
POWER_FORECAST_PORT=8000

# Keep this directory across container recreation. Never mix old model caches.
POWER_FORECAST_RUNTIME_DIR=./runtime
